# Copy this file to ".env" and put real values there.
# ".env" is in .gitignore and must NEVER be committed.

# Username PostgreSQL creates on first start (also used by both APIs)
POSTGRES_USER=library
# Password for that user - CHANGE THIS in your real .env
POSTGRES_PASSWORD=change_me
# Name of the database PostgreSQL creates on first start
POSTGRES_DB=library
